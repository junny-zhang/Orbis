if SHIELD_ORBIS_LEFT

config ZMK_KEYBOARD_NAME
    default "Orbis"

# 左手是中央：负责 BLE/USB 与主机通信，并接收右手转发来的轨迹球事件
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_POINTING
    default y

# EC11 编码器（左手）
config EC11
    default y

config EC11_TRIGGER_GLOBAL_THREAD
    default y

endif # SHIELD_ORBIS_LEFT

if SHIELD_ORBIS_LEFT || SHIELD_ORBIS_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_ORBIS_RIGHT

# 右手同时挂了 74HC595（矩阵列驱动）和 PMW3360（SPI 轨迹球）
config ZMK_POINTING
    default y

config SPI
    default y

config INPUT
    default y

endif # SHIELD_ORBIS_RIGHT
