/*
 * Orbis —— 分体键盘共享设备树（由 hardware/plate/gen_firmware.py 生成，勿手改）
 *   左手（中央）：5 行 × 7 列，30 键 + 编码器按压在 (4,5)
 *   右手（外围）：5 行 × 8 列，40 键（第 1 行第 9 个键落在矩阵 (4,7)）
 *
 * 虚拟矩阵 = 5 行 × 15 列：左手 kscan 列 0..6 -> 虚拟列 0..6，
 * 右手 kscan 列 0..7 -> 虚拟列 7..14（见 orbis_right.overlay 的 col-offset）
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <15>;
        rows = <5>;
// 键位顺序（keymap 里 bindings 的顺序）：
//   第0组(15): Esc !/1 @/2 #/3 $/4 %/5 ^/6 &/7 */8 (/9 )/0 _/- +/= Backspace ~/`
//   第1组(15): Tab Q W E R T Y U I O P {/[ }/] |/\ PgUp
//   第2组(14): Caps Lock A S D F G H J K L :/; "/' Enter PgDn
//   第3组(14): Shift Z X C V B N M </, >/. ?// Shift PrtSc/↑ Insert/Del
//   第4组(13): Fn Ctrl Win Alt Space ENC Space Fn Ctrl Alt Home/← Pause/Break/↓ end/→
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(4,14)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };

    /* 行/列脚都在各自 .overlay 里补 —— 左右手的行脚不同
     * （左手把 D2/D3 让给了 OLED 的 I2C，行脚是 D0,D1,D16,D21,D4） */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
    };

    /* 左手 EC11 编码器（装在外壳上，经 J2 排线接入） */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* D19  P0.02 */
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* D20  P0.29 */
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    /* 右手轨迹球：外围侧定义设备，中央侧接收事件 */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };
};
